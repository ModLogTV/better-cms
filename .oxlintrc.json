{
	"plugins": ["react", "import", "promise", "node"],
	"categories": {
		"correctness": "error",
		"suspicious": "error",
		"perf": "error"
	},
	"rules": {
		"react/react-in-jsx-scope": "off",
		"no-underscore-dangle": ["error", { "allow": ["_type", "_vars", "_tags"] }]
	},
	"ignorePatterns": ["dist/**", "graphify-out/**", "**/routeTree.gen.ts"]
}

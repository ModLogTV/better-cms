{
	"name": "@modlog/better-cms",
	"version": "0.1.0",
	"description": "Framework-agnostic type-safe, self-hosted full-stack TypeScript CMS for translations, asset management and page content.",
	"type": "commonjs",
	"main": "./dist/core/index.js",
	"types": "./dist/core/index.d.ts",
	"files": [
		"dist"
	],
	"scripts": {
		"prebuild": "rm -rf dist",
		"build": "tsup && bun run build:admin",
		"build:lib": "tsup",
		"build:admin": "cd admin-ui && bun install && bun run build",
		"build:watch": "tsup --watch",
		"typecheck": "tsc --noEmit",
		"test": "tsc --noEmit && bun test",
		"lint": "biome lint .",
		"lint:biome-ignore": "bun run scripts/check-biome-ignore-reasons.ts",
		"format": "biome check --write .",
		"format:check": "biome check .",
		"check": "biome check --write ."
	},
	"workspaces": ["admin-ui", "demo/*"],
	"keywords": [
		"cms",
		"i18n",
		"translations",
		"elysia",
		"nextjs"
	],
	"author": "Daniel Dopatka (ModLog UG)",
	"license": "ISC",
	"engines": {
		"node": ">=20"
	},
	"exports": {
